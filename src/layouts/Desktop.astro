---
// The whole site is one Mac desktop: the menu bar on top is the navigation, the page is the wallpaper's content, and
// a quiet colophon closes it. Inner pages open with a display window holding the page's title (their one h1); the home
// page brings its own h1 and the stage (src/pages/index.astro).
import Base from "./Base.astro";
import { hasBlog, hasUseCases } from "../data/content";

export type Page = "home" | "install" | "faq" | "usecases" | "blog" | "none";
// headline: the page's h1, shown lit in the display window at the top (omit it on the home page, which has its own)
interface Props { title: string; description: string; page: Page; headline?: string; jsonLd?: object[]; ogImage?: string; noindex?: boolean }
const { title, description, page, headline, jsonLd, ogImage, noindex } = Astro.props;

// Use cases and Blog appear in the menu bar only once each has a first live page.
const nav: [Page, string, string][] = [
  ["install", "Install", "/install/"], ["faq", "FAQ", "/faq/"],
  ...((await hasUseCases()) ? [["usecases", "Use cases", "/use-cases/"] as [Page, string, string]] : []),
  ...((await hasBlog()) ? [["blog", "Blog", "/blog/"] as [Page, string, string]] : []),
];
const current = { home: "Home", install: "Install", faq: "FAQ", usecases: "Use cases", blog: "Blog", none: "404" }[page];
---
<Base title={title} description={description} jsonLd={jsonLd} ogImage={ogImage} noindex={noindex}>
  <div class="desk" data-page={page}>
    <header class="menubar">
      <a class="mb-brand" href="/" aria-current={page === "home" ? "page" : undefined}><img src="/favicon.png" alt="" width="16" height="16" />cl_quick</a>
      <nav class="mb-links" aria-label="Site">{nav.map(([id, label, href]) => <a href={href} aria-current={id === page ? "page" : undefined}>{label}</a>)}</nav>
      <span class="spacer"></span>
      <!-- the app's own icon in the menu bar, as it sits on a Mac -->
      <svg class="mb-icon" viewBox="0 0 512 512" aria-hidden="true"><rect x="40" y="156" width="432" height="200" rx="100" fill="none" stroke="#f5f5f7" stroke-width="40"/><circle cx="364" cy="256" r="40" fill="#f5f5f7"/></svg>
      <span class="mb-clock" aria-hidden="true"></span>
    </header>

    {headline ? (
      <main class="page">
        <div class="disp" role="presentation"><em>{current}</em><h1>{headline}</h1></div>
        <slot />
      </main>
    ) : (
      <main class="home-main"><slot /></main>
    )}

    <footer class="colophon">
      <span>cl_quick is made by <a href="https://n-uf.com">n-uf</a></span>
      <span>PolyForm Perimeter 1.0.1</span>
      <span>The quick chat of <a href="https://cl-audit.n-uf.com">cl_audit</a>, as an app of its own</span>
    </footer>
  </div>
</Base>

<script>
  // The menu bar clock, like the Mac's, in the visitor's own date and time format.
  const tick = () => {
    const el = document.querySelector<HTMLElement>(".mb-clock");
    if (!el) return;
    const d = new Date();
    el.textContent = d.toLocaleDateString(undefined, { weekday: "short", day: "numeric", month: "short" }).replace(/,/g, "") +
      "  " + d.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
  };
  tick();
  setInterval(tick, 20000);
</script>
