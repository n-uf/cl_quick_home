---
import Desktop from "../layouts/Desktop.astro";
import ExtLink from "../components/ExtLink.astro";
import "../styles/home.css";
import { pageOf } from "../data/pages";
import BigKey from "../components/BigKey.astro";
import { site, release } from "../data/site";
import { hasBlog } from "../data/content";
import { orgNode, orgRef, appRef } from "../data/schema";

// the three big keys: release-tied, so they stay as links to /install/ or as disabled keys until site.ts has the targets
const blogLive = await hasBlog();

// Main search: "claude quick chat". The title, description, h1 and first paragraph all lead with it.
const page = pageOf("/");
const alternateName = ["cl-quick", "cl quick"];
const jsonLd = [orgNode, {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}/#website`,
  name: "cl_quick",
  alternateName,
  url: `${site}/`,
  publisher: orgRef,
}, {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${site}/#webpage`,
  name: page.title,
  description: page.description,
  url: `${site}/`,
  dateModified: page.updated,
  inLanguage: "en",
  isPartOf: { "@id": `${site}/#website` },
  about: appRef,
  author: orgRef,
  publisher: orgRef,
}, {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  // the other pages point to the app by this id
  "@id": `${site}/#app`,
  name: "cl_quick",
  alternateName,
  description: "cl_quick is a Claude quick chat for the Mac: a menu bar app with no Dock icon. Press ⌥Space over any app and a chat bar opens; the first message turns it into a chat window that floats on every Space and never brings another app forward. Your own Claude Code sign-in answers, on the profile's account in use, and it counts against that account's limits.",
  applicationCategory: "UtilitiesApplication",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },   // the app costs nothing; no downloadUrl and no version until the release
  operatingSystem: "macOS 13 or later",
  url: `${site}/`,
  image: `${site}/icon-192.png`,
  featureList: [
    "A floating Claude chat on a shortcut (⌥Space by default) that never brings another app forward",
    "Answered by your own Claude Code sign-in, on the profile's account in use",
    "The live 5-hour and weekly limits of the account in use, in the bar and in the chat's header",
    "Profiles with several accounts each, with Switch… through Claude Code's own sign-in",
    "Model and thinking pickers, and a mic button that starts macOS Dictation",
    "Incognito chats: nothing is saved on the Mac",
  ],
  author: orgRef,
  publisher: orgRef,
}];

// the steps: each has the stage picture it shows (see home.css: data-beat on .home)
const keys = ["Press", "Bar", "Type", "Chat", "Incognito", "Limits"];
---
<Desktop title={page.title} description={page.description} page="home" jsonLd={jsonLd}>
  <div class="home">
    <!-- with the script on: the steps dim and light up with the scroll, and the stage follows. Without it the stage
         shows the chat window and the steps are plain text. Set before the first paint so nothing flashes. -->
    <script is:inline>(function () { var h = document.currentScript.parentElement; h.setAttribute("data-js", ""); h.setAttribute("data-beat", "0"); })();</script>

    <section class="intro">
      <p class="lbl">Menu bar app for Mac</p>
      <h1>A Claude quick chat for your Mac, on <span class="nb">⌥Space</span></h1>
      <p class="lede">cl_quick is a free menu bar app for Mac, a Claude quick chat. Press <span class="kbd">⌥Space</span> over any app and a floating bar opens; your first message turns it into a chat window that stays on every Space until you press Esc. Your own Claude Code sign-in answers, on the profile's account in use, and it counts against that account's limits.</p>
      <p class="lede">cl_quick is made by <ExtLink href="https://n-uf.com">n-uf</ExtLink> and is not affiliated with Anthropic.</p>
      <p class="readout"><span class="led lit" aria-hidden="true"></span><b>The first release isn't out yet.</b> There is nothing to download so far. <a href="/install/">What it needs</a></p>
    </section>

    <div class="show">
      <div class="rig">
        <div class="stage" role="group" aria-label="A Mac desktop with cl_quick floating over it (picture)">
          <div class="mini-menu" aria-hidden="true">
            <!-- generic status glyphs (Wi-Fi, battery, Control Centre), then cl_quick's own icon, then the clock -->
            <svg class="mm-wifi" viewBox="0 0 24 24"><path d="M2.5 9.2a14 14 0 0 1 19 0M5.6 12.5a9.5 9.5 0 0 1 12.8 0M8.7 15.7a5 5 0 0 1 6.6 0" fill="none" stroke="#f2f2f6" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="19" r="1.5" fill="#f2f2f6"/></svg>
            <svg viewBox="0 0 28 24" style="width:2.8cqw"><rect x="1.5" y="6.5" width="21" height="11" rx="3" fill="none" stroke="#f2f2f6" stroke-width="1.6" opacity=".75"/><rect x="3.5" y="8.5" width="14" height="7" rx="1.5" fill="#f2f2f6"/><path d="M24.5 10v4" stroke="#f2f2f6" stroke-width="1.8" stroke-linecap="round" opacity=".75"/></svg>
            <svg viewBox="0 0 24 24"><rect x="2" y="4" width="14" height="6.5" rx="3.25" fill="none" stroke="#f2f2f6" stroke-width="1.7"/><circle cx="6.5" cy="7.25" r="1.9" fill="#f2f2f6"/><rect x="8" y="13.5" width="14" height="6.5" rx="3.25" fill="none" stroke="#f2f2f6" stroke-width="1.7"/><circle cx="17.5" cy="16.75" r="1.9" fill="#f2f2f6"/></svg>
            <span class="me"><svg viewBox="0 0 512 512"><rect x="40" y="156" width="432" height="200" rx="100" fill="none" stroke="#ffffff" stroke-width="40"/><circle cx="364" cy="256" r="40" fill="#ffffff"/></svg></span>
            <span class="clock">Wed 9:41</span>
          </div>
          <div class="desk-items" aria-hidden="true">
            <span><svg viewBox="0 0 48 48"><path d="M4 12a4 4 0 0 1 4-4h11l4 4h17a4 4 0 0 1 4 4v22a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z" fill="#58a6f0"/><path d="M4 18a4 4 0 0 1 4-4h32a4 4 0 0 1 4 4v20a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z" fill="#7cc0ff"/></svg>Projects</span>
            <span><svg viewBox="0 0 48 48"><rect x="7" y="5" width="34" height="38" rx="4" fill="#f4f4f7"/><rect x="12" y="10" width="24" height="17" rx="2" fill="#7f6bd8"/><circle cx="18" cy="16" r="2.6" fill="#ffd27a"/><path d="M12 27l8-8 6 6 4-4 6 6z" fill="#4d3fa8"/><rect x="12" y="32" width="16" height="2.6" rx="1.3" fill="#b8b8c4"/><rect x="12" y="37" width="10" height="2.6" rx="1.3" fill="#b8b8c4"/></svg>Screenshot</span>
          </div>
          <div class="bezel" aria-hidden="true"><span class="notch"></span></div>

          <!-- step 1: the keys. With the script on they are one button that plays the key press and goes to step 2;
               without it they stay a picture (home.css shows one or the other) -->
          <div class="caps">
            <div class="keyrow still" aria-hidden="true"><span class="kcap">⌥</span><span class="kcap space">Space</span></div>
            <button type="button" class="keybtn" aria-label="Press ⌥Space to open the chat bar"><span class="keyrow"><span class="kcap">⌥</span><span class="kcap space">Space</span></span></button>
            <span class="say" aria-hidden="true"><span class="say-still">Option + Space</span><span class="say-js">Click or press ⌥Space</span></span>
          </div>

          <figure class="layer l-bar"><img src="/img/qc-bar.webp" width="880" height="154" alt="cl_quick's chat bar on the desktop" loading="eager" decoding="async" />
            <!-- with the script on, the field is a real text input over the picture (home.css puts it in % of the picture);
                 without it there is nothing here, only the picture. What is typed goes nowhere: see the script below. -->
            <div class="live">
              <textarea class="live-field" rows="1" maxlength="200" placeholder="Ask anything" aria-label="Try the chat bar: type a question" spellcheck="false" autocomplete="off"></textarea>
              <button type="button" class="live-send" aria-label="Send" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V6M6.5 11.5 12 6l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
          </figure>
          <figure class="layer l-typing"><img src="/img/qc-typing.webp" width="880" height="154" alt="The bar with a question typed in it" loading="lazy" decoding="async" /></figure>
          <figure class="layer l-answer"><img src="/img/qc-answer.webp" width="880" height="880" alt="The chat window with an answer and a code block" loading="eager" decoding="async" /></figure>
          <figure class="layer l-full"><img src="/img/qc-full.webp" width="880" height="384" alt="A notice that the week is full, with Ask on Work" loading="lazy" decoding="async" /></figure>
          <figure class="layer l-ended"><img src="/img/qc-ended.webp" width="880" height="880" alt="The chat window after it ended, idle for 15 minutes" loading="lazy" decoding="async" /></figure>
          <!-- the visitor's own words in the window: the picture of the window with its message area redrawn in HTML.
               The text is put in with textContent (never as HTML), and a notice stands where an answer would be -->
          <div class="layer l-sent">
            <img src="/img/qc-answer.webp" width="880" height="880" alt="" loading="lazy" decoding="async" />
            <div class="sent-panel" aria-hidden="true">
              <p class="sent-bubble"></p>
              <p class="sent-notice"><span class="dot"></span>This is a picture of cl_quick. On your Mac, your own Claude Code answers here.</p>
            </div>
          </div>
          <p class="sr-only" role="status" aria-live="polite" data-sent-say></p>
        </div>
        <nav class="plate keys" aria-label="Steps">
          {keys.map((k, i) => <a class="key" href={`#step-${i + 1}`} aria-label={`Step ${i + 1}: ${k}`}><span class="n">{i + 1}</span><span class="w">{k}</span></a>)}
        </nav>
      </div>

      <ol class="beats">
        <li class="beat" id="step-1">
          <h2>Press ⌥Space over any app</h2>
          <p>A chat bar opens over whatever you're doing. cl_quick is a menu bar app with no Dock icon, and it never brings another app forward: whatever you're working in stays in front. ⌥Space is the default; Settings offers four other Space shortcuts, any key with ⌘, ⌃ or ⌥, or none.</p>
        </li>
        <li class="beat" id="step-2">
          <h2>A bar opens, ready to type</h2>
          <p>Under the field, in one row, sit the profile (a dot in the colour of its fuller limit, and its name), the model and thinking in one outlined group, a keys button, and at the end the mic and Send. Haiku is the default model and thinking is off. A pick holds for that chat, and a new chat goes back to the defaults.</p>
        </li>
        <li class="beat" id="step-3">
          <h2>Type, and press Return</h2>
          <p>Return sends and Shift-Return adds a line. The mic button, left of Send, starts macOS Dictation into the field, and the keys button lists the shortcuts.</p>
        </li>
        <li class="beat" id="step-4">
          <h2>The first message makes it a chat window</h2>
          <p>The bar turns into a chat window that floats on every Space. Answers stream in as Markdown, code blocks have Copy, and each answer says which model gave it and how long it took. Esc or ⌘W hides the window, and ⌘N starts a new chat.</p>
        </li>
        <li class="beat" id="step-5">
          <h2>Incognito: nothing saved on this Mac</h2>
          <p>Quick chats are incognito: nothing is saved on this Mac. Your messages still go to Anthropic under the profile's account. A chat ends after 15 minutes idle, and the window says so. <a href="/faq/#incognito">What incognito means here</a></p>
        </li>
        <li class="beat" id="step-6">
          <h2>Your limits stay in view</h2>
          <p>When the 5-hour limit or the week is full, the chat's notice names the window that is full and when it resets, and offers the profile with the most room (<b>Ask on Work</b>). If the profile has a standby account with room, it also offers to switch to it (<b>Switch to …</b>). The bar has a usage indicator, and in the chat window the header shows only the 5h and wk meters, in green, amber from 50%, red from 80% and crimson from 95%.</p>
        </li>
      </ol>
    </div>
  </div>

  <!-- the story's end: three big keys, in the stage's column. Download goes to /install/ until there is a release; GitHub
       and Blog are disabled keys until site.ts has the repository and there is a live article. (Outside .home, so the
       pinned stage ends with the story and never slides over them.) -->
  <div class="gethost">
    <!-- with the script on, the row sticks once the reader is past it: under the menu bar on a computer, as a bar along
         the bottom on a phone (see the script). The slot keeps the row's place, so nothing moves when it sticks. -->
    <div class="getslot">
      <span class="get-sentinel" aria-hidden="true"></span>
      <nav class="getrow plate" aria-label="Download, GitHub and blog">
        <BigKey label="Download" more=" for Mac" href={release.downloadUrl ?? "/install/"} sub={release.downloadUrl ? "Apple silicon · macOS 13+" : "Not released yet"} />
        <BigKey label="GitHub" href={release.repoUrl} arrow sub={release.repoUrl ? "n-uf/cl_quick" : "With the first release"} />
        <BigKey label="Blog" href={blogLive ? "/blog/" : null} sub={blogLive ? "Guides and how-tos" : "First posts with the release"} />
      </nav>
    </div>
  </div>

  <section class="sheet" aria-labelledby="sheet-h">
    <div class="sheet-head">
      <p class="lbl">What it is, exactly</p>
      <h2 id="sheet-h">cl_quick, one part at a time</h2>
    </div>

    <div class="row" id="claude-code">
      <div><span class="lbl">Answers</span><h3>Your own Claude Code answers</h3></div>
      <div class="body">
        <p>cl_quick uses your own Claude Code sign-in: your Claude Code answers, on the profile's account in use, and every chat counts against that account's limits. It keeps one <code>claude</code> running while a chat is open and ends it after 15 minutes idle. The app is light, too: it has no Dock icon and is under 5 MB.</p>
        <p>It needs an Apple silicon Mac, macOS 13 or later and Claude Code, signed in. <a href="/install/">Install: what it needs</a></p>
      </div>
    </div>

    <div class="row" id="profiles">
      <div><span class="lbl">Profiles</span><h3>Profiles, with several accounts each</h3></div>
      <div class="body">
        <p>A profile is a Claude Code folder cl_quick chats on: <code>~/.claude</code>, a <code>~/.claude-*</code> folder, or any folder set with <code>CLAUDE_CONFIG_DIR</code>. On its first run cl_quick takes every signed-in one it finds, named after the folder.</p>
        <p>A Claude Code folder holds one signed-in account at a time, so a profile remembers the accounts that have been signed in to its folder: the one signed in now is <b>in use</b>, the others are <b>standby</b>. In the profile's page in Settings each standby account is a row with two buttons, <b>Switch…</b> and <b>Forget…</b>; pressing <b>Switch…</b> asks first, then opens Claude Code's own sign-in in Terminal. cl_quick never sees a password or a token and never touches the Keychain.</p>
        <figure class="shot">
          <img src="/img/settings-accounts.webp" width="1210" height="687" alt="Settings: an account in use and two on standby" loading="lazy" decoding="async" />
          <figcaption>A profile's page in Settings, with sample accounts: one in use, two on standby.</figcaption>
        </figure>
        <p><a href="/faq/#switching">How switching accounts works</a></p>
      </div>
    </div>

    <div class="row" id="controls">
      <div><span class="lbl">Controls</span><h3>Model, thinking, voice and shortcut</h3></div>
      <div class="body">
        <p>The shortcut is ⌥Space by default. Settings ▸ General offers four other Space shortcuts, Other… for any key with ⌘, ⌃ or ⌥, or Off. It warns only about real clashes: a macOS shortcut that uses the key, or a key another app holds when macOS refuses to register it. It needs no Accessibility permission.</p>
        <figure class="shot">
          <img src="/img/settings-shortcut.webp" width="1210" height="108" alt="Settings, General: the Shortcut row" loading="lazy" decoding="async" />
          <figcaption>Settings ▸ General ▸ Shortcut, with ⌥Space picked.</figcaption>
        </figure>
        <p>The model is one of four families, Haiku, Sonnet, Opus and Fable, each the newest the account has; a family the account lacks isn't offered. Thinking is off or one of the efforts the chosen model takes (Low, Medium, High, Extra, Max). The pickers change the running <code>claude</code>, so a chat keeps its conversation.</p>
        <figure class="shot">
          <img src="/img/settings-general.webp" width="1210" height="282" alt="Settings, General: Model, Thinking, Open at login" loading="lazy" decoding="async" />
          <figcaption>Settings ▸ General: the model and thinking a new chat starts with, and Open at login.</figcaption>
        </figure>
        <p>The mic button starts macOS Dictation into the field; cl_quick stays in the background, so Dictation types into the field and not into the app behind it.</p>
        <figure class="shot narrow">
          <img src="/img/qc-dictating.webp" width="880" height="154" alt="The bar with the mic button on" loading="lazy" decoding="async" />
          <figcaption>Dictation on: the mic button is lit while macOS types into the field.</figcaption>
        </figure>
      </div>
    </div>

    <div class="row" id="incognito">
      <div><span class="lbl">Incognito</span><h3>Incognito chats, said exactly</h3></div>
      <div class="body">
        <div class="exact">
          <p><b>Nothing is saved on this Mac.</b> Your messages still go to Anthropic under the profile's account. It is not Anthropic's own incognito mode.</p>
        </div>
        <p>A chat lives only in the running Claude Code, which writes no transcript, so it ends with it: after 15 minutes idle, on New chat (⌘N), on another profile or account, if Claude Code crashes, or when cl_quick quits. The window then says "This chat ended after 15 minutes idle. Nothing was saved." and the next message starts a new chat. <a href="/faq/#keeps">What cl_quick keeps and sends</a></p>
      </div>
    </div>

    <div class="row" id="cl-audit">
      <div><span class="lbl">With cl_audit</span><h3>The quick chat of cl_audit, as an app of its own</h3></div>
      <div class="body">
        <p>cl_quick is the successor of the quick chat in <ExtLink href="https://cl-audit.n-uf.com">cl_audit</ExtLink>. Its settings window wears cl_audit's look, while the chat itself uses Claude's colours. It runs with or without cl_audit and shares nothing with it while running. On its first run it copies cl_audit's old quick chat settings (the shortcut, model and thinking), if there are any.</p>
      </div>
    </div>

    <div class="row" id="next">
      <div><span class="lbl">Next</span><h3>Before the first release</h3></div>
      <div class="body">
        <p>The first release isn't out yet. The Install page lists what cl_quick needs, and the FAQ answers what it keeps and sends, how accounts switch, and how the model, thinking, shortcut and voice controls work.</p>
        <div class="next">
          <a class="key" href="/install/">Install</a>
          <a class="key" href="/faq/">FAQ</a>
        </div>
      </div>
    </div>
  </section>
</Desktop>

<script>
  // Which step is lit: the last step whose top has passed a line (halfway down the screen; on a phone, just under the
  // pinned stage). The stage and the step keys follow data-beat on .home.
  const home = document.querySelector<HTMLElement>(".home");
  if (home) {
    const beats = [...home.querySelectorAll<HTMLElement>(".beat")];
    const rig = home.querySelector<HTMLElement>(".rig")!;
    const phone = matchMedia("(max-width: 860px)");
    let cur = -1, queued = false;
    const update = () => {
      queued = false;
      const line = phone.matches ? rig.getBoundingClientRect().bottom + 60 : window.innerHeight * 0.55;
      let n = 0;
      beats.forEach((b, i) => { if (b.getBoundingClientRect().top <= line) n = i; });
      if (n !== cur) { cur = n; home.dataset.beat = String(n); if (n < 3) home.classList.remove("sent"); }   // back at steps 1 to 3: the pictures reset, the typed text stays
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    // the pinned stage's height, for the steps' scroll margin on a phone (home.css)
    const measure = () => home.style.setProperty("--rig-h", `${rig.offsetHeight}px`);
    if ("ResizeObserver" in window) new ResizeObserver(measure).observe(rig); else measure();
    // a step key lights its step at once, without waiting for the scroll to arrive
    home.querySelectorAll<HTMLAnchorElement>(".keys a").forEach((a, i) => a.addEventListener("click", () => { cur = i; home.dataset.beat = String(i); if (i < 3) home.classList.remove("sent"); }));
    // The bar's field (steps 2 and 3). What the visitor types goes nowhere: no request, no storage, no analytics. It is
    // only put on the page (as text, never as HTML, at most 200 characters) in the window's bubble when they send it, and it
    // is gone when the page is closed. A picture of cl_quick says so in the place of an answer.
    const field = home.querySelector<HTMLTextAreaElement>(".live-field");
    const sendBtn = home.querySelector<HTMLButtonElement>(".live-send");
    const bubble = home.querySelector<HTMLElement>(".sent-bubble");
    const say = home.querySelector<HTMLElement>("[data-sent-say]");
    const notice = home.querySelector<HTMLElement>(".sent-notice");
    if (field && sendBtn && bubble && say && notice) {
      const touch = () => home.classList.add("touched");
      const sync = () => { sendBtn.disabled = field.value.trim() === ""; };
      const submit = () => {
        const text = field.value.trim().slice(0, 200);
        if (!text) return;   // an empty field: Return does nothing
        bubble.textContent = text;
        say.textContent = `You asked: “${text}”. ${notice.textContent}`;
        home.classList.add("sent");
        home.querySelector<HTMLAnchorElement>(".keys a:nth-child(4)")?.click();   // the window step, as the step key goes there
      };
      field.addEventListener("focus", touch);
      field.addEventListener("input", () => { touch(); sync(); });
      field.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey && !e.isComposing) { e.preventDefault(); submit(); }   // Shift-Return adds a line
      });
      sendBtn.addEventListener("click", submit);
      // a click on the bar (outside the field) focuses it; on step 3's typed picture it brings the live bar in first
      home.querySelector(".l-bar")?.addEventListener("pointerdown", (e) => { if (e.target !== field && e.target !== sendBtn && !sendBtn.contains(e.target as Node)) { e.preventDefault(); field.focus(); } });
      home.querySelector(".l-typing")?.addEventListener("pointerdown", (e) => { e.preventDefault(); touch(); field.focus(); });
      sync();
    }
    // step 1's keys: a click (or Enter or Space on the button), or a real ⌥Space on the page, plays a key press of about
    // 150 ms and then goes to step 2 exactly as the step keys do (no press animation with reduced motion)
    const keybtn = home.querySelector<HTMLButtonElement>(".keybtn");
    const toStep2 = () => {
      home.querySelector<HTMLAnchorElement>(".keys a:nth-child(2)")?.click();
      // like the real bar, the field is ready to type in (not on a touch screen, where it would raise the keyboard)
      if (matchMedia("(hover: hover)").matches) field?.focus({ preventScroll: true });
    };
    let pressing = false;
    const press = () => {
      if (pressing) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches || !keybtn) { toStep2(); return; }
      pressing = true;
      keybtn.classList.add("down");
      setTimeout(() => { keybtn.classList.remove("down"); pressing = false; toStep2(); }, 150);
    };
    keybtn?.addEventListener("click", press);
    addEventListener("keydown", (e) => {
      if (!(e.altKey && e.code === "Space") || e.metaKey || e.ctrlKey || e.shiftKey || e.repeat) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.isContentEditable || /^(input|textarea|select)$/i.test(t.tagName))) return;
      e.preventDefault();
      press();
    });
    // a link reached with the keyboard in a step must not hide under the pinned stage
    home.addEventListener("focusin", (e) => {
      const t = e.target as HTMLElement;
      if (!phone.matches || !t.closest(".beats")) return;
      const room = rig.getBoundingClientRect().bottom + 12 - t.getBoundingClientRect().top;
      if (room > 0) scrollBy(0, -room);
    });
    update();
  }

  // The row of big keys sticks once the reader is past it (script on only). Desktop: under the menu bar, compact, to the end
  // of the page. Phone: a compact bar along the bottom, shown only once past the story (so never while the pinned stage is
  // on screen). A sentinel at the row's top and an IntersectionObserver decide; the slot keeps the row's height, so the page
  // doesn't shift. While stuck, scroll padding keeps anchors and keyboard focus clear of the row.
  const slot = document.querySelector<HTMLElement>(".getslot");
  const sentinel = slot?.querySelector<HTMLElement>(".get-sentinel");
  if (slot && sentinel && "IntersectionObserver" in window) {
    const narrow = matchMedia("(max-width: 860px)");
    const rail = matchMedia("(min-width: 1260px)");   // wide enough for the keys to stand at the right of the sheet's text (home.css)
    const root = document.documentElement;
    let observer: IntersectionObserver | undefined;
    const setStuck = (on: boolean) => {
      if (on === slot.classList.contains("stuck")) return;
      if (on) {
        const r = slot.getBoundingClientRect();
        slot.style.height = `${r.height}px`;
        slot.style.setProperty("--get-left", `${r.left}px`);
        slot.style.setProperty("--get-w", `${r.width}px`);
      } else slot.style.height = "";
      slot.classList.toggle("stuck", on);
      // wide desktop: the keys stand in a rail at the right, so only the menu bar needs room above; otherwise a strip under it
      root.style.scrollPaddingTop = on && !narrow.matches ? (rail.matches ? "44px" : "100px") : "";
      root.style.scrollPaddingBottom = on && narrow.matches ? "84px" : "";
    };
    let top = 36;
    // an IntersectionObserver tells nothing when a jump (a step key, an anchor, End) skips past the sentinel without it ever
    // being in view, so the scroll position is also checked directly
    const check = () => setStuck(sentinel.getBoundingClientRect().top < top);
    const watch = () => {
      observer?.disconnect();
      setStuck(false);
      top = narrow.matches ? 0 : 36;   // under the 28 px menu bar with an 8 px gap, or the top of the screen
      observer = new IntersectionObserver(([e]) => setStuck(!e.isIntersecting && e.boundingClientRect.top < top), { rootMargin: `-${top}px 0px 0px 0px`, threshold: 0 });
      observer.observe(sentinel);
      check();
    };
    watch();
    let checking = false;
    addEventListener("scroll", () => { if (!checking) { checking = true; requestAnimationFrame(() => { checking = false; check(); }); } }, { passive: true });
    let resizing = 0;
    addEventListener("resize", () => { clearTimeout(resizing); resizing = window.setTimeout(watch, 150); });
  }
</script>
