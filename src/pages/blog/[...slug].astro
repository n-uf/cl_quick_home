---
// /blog/ (the index) and /blog/<slug>/ (an article) in one route, so that neither exists while the blog is empty.
import { render } from "astro:content";
import Desktop from "../../layouts/Desktop.astro";
import Reader from "../../layouts/Reader.astro";
import "../../styles/reader.css";
import ScheduledBadge from "../../components/ScheduledBadge.astro";
import { getPosts, pathOf, dateText, kindLabel, isLive, showDrafts } from "../../data/content";
import { orgNode, webPage, breadcrumbs } from "../../data/schema";
import { withImages } from "../../data/images";
import { withLiveBlocks } from "../../data/live";

export async function getStaticPaths() {
  const posts = await getPosts();
  if (posts.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { posts } },
    ...posts.map((entry) => ({ params: { slug: entry.id }, props: { posts, entry } })),
  ];
}
const { posts, entry } = Astro.props;
const rendered = entry ? await render(entry) : undefined;
// the body with its {{live:}} blocks resolved (src/data/live.ts), its images as sized figures (src/data/images.ts), ; the plain component if there is no rendered HTML
const html = entry?.rendered?.html ? withImages(await withLiveBlocks(entry.rendered.html, entry.filePath ?? `src/content/blog/${entry.id}.md`)) : undefined;

const title = "Claude quick chat blog | cl_quick";
const description = "Short guides for cl_quick, the floating Claude chat for the Mac: how it works with Claude Code, what it keeps and sends, and how accounts and limits show.";
const jsonLd = [
  webPage({ path: "/blog/", name: title, description, type: "CollectionPage" }),
  breadcrumbs([{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }]),
  orgNode,
];
---
{entry && rendered ? (
  <Reader entry={entry} section="blog" headings={rendered.headings}>{html ? <Fragment set:html={html} /> : <rendered.Content />}</Reader>
) : (
  <Desktop title={title} description={description} page="blog" headline="Guides for the quick chat" jsonLd={jsonLd}>
    <div class="content-inner reader">
      <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Blog</li></ol></nav>
      <p class="ix-lede">Short guides on using cl_quick with Claude Code. Newest first, each with the date it was last updated.</p>
      <div class="ix-list">
        {posts.map((e) => (
          <div class="card">
            <h4>{kindLabel[e.data.kind]}</h4>
            <h2><a href={pathOf("blog", e.id)}>{e.data.h1}</a></h2>
            <p>{e.data.description}</p>
            <span class="when">Updated {dateText(e.data.updated)}</span>
            {showDrafts && !isLive(e) && <ScheduledBadge date={e.data.published} />}
          </div>
        ))}
      </div>
    </div>
  </Desktop>
)}
